// Modal coefficients, energy accounting and span-projection math.
@init

// ---- modal ----

// Positive quadratic string-energy proxy, omitting common linear density / 4.
function mb_bank_energy(base, count, length)
local(i, ptr, q, v, sum)
global(MB_M_ALPHA, MB_M_I, MB_M_OMEGA, MB_M_R, MB_MODE_STRIDE)
(
  sum=0; i=0;
  loop(count,
    ptr=base+i*MB_MODE_STRIDE; q=ptr[MB_M_R];
    v=-ptr[MB_M_ALPHA]*q-ptr[MB_M_OMEGA]*ptr[MB_M_I];
    sum+=v*v+(ptr[MB_M_OMEGA]^2+ptr[MB_M_ALPHA]^2)*q*q;
    i+=1;
  );
  length*sum;
);

// Calculate coefficients only; excitation owns R/I and initial displacement.
function mb_modal_coefficients(st)
local(cfg, g, i, n, ptr, freq, omega, alpha, radius, angle)
(
  cfg=st+MB_CONFIG; g=st+MB_GEOMETRY;
  st[MB_S_COUNT]=0; i=0;
  loop(min(MB_MAX_MODES, floor(cfg[MB_C_MODES])),
    n=i+1;
    freq=n*g[MB_G_F1]*sqrt((1+g[MB_G_STIFFNESS]*n*n)/(1+g[MB_G_STIFFNESS]));
    freq<0.48*srate ? (
      omega=2*$pi*freq;
      alpha=mb_modal_alpha(freq, cfg, g);
      radius=exp(-alpha/srate); angle=omega/srate;
      ptr=st[MB_S_ACTIVE]+i*MB_MODE_STRIDE;
      ptr[MB_M_ROT_R]=radius*cos(angle);
      ptr[MB_M_ROT_I]=radius*sin(angle);
      ptr[MB_M_ALPHA]=alpha; ptr[MB_M_OMEGA]=omega;
      ptr[MB_M_FREQ]=freq;
      st[MB_S_COUNT]+=1;
    );
    i+=1;
  );
  mb_fret_response_coefficients(st, st[MB_S_ACTIVE], cfg, g);
);

// Observe exact velocity BEFORE advancing the complex oscillator.
// Carry the running sum across a contact prefix without regrouping additions.
function mb_modal_render_continue(base, weights, count, damper, initial)
local(i, ptr, r, im, nr, ni, sum, rr, ri)
global(MB_M_ALPHA, MB_M_I, MB_M_OMEGA, MB_M_R, MB_M_ROT_I, MB_M_ROT_R, MB_MODE_STRIDE)
(
  // Four sequential modes per loop; preserve summation and rotation order.
  // Cache rotation reads. The remainder also handles counts below four.
  sum=initial; i=0; ptr=base;
  loop(floor(count/4),
    r=ptr[MB_M_R]; im=ptr[MB_M_I];
    sum+=(-ptr[MB_M_ALPHA]*r-ptr[MB_M_OMEGA]*im)*weights[i];
    rr=ptr[MB_M_ROT_R]; ri=ptr[MB_M_ROT_I];
    nr=(r*rr-im*ri)*damper;
    ni=(r*ri+im*rr)*damper;
    ptr[MB_M_R]=nr; ptr[MB_M_I]=ni;
    ptr+=MB_MODE_STRIDE; i+=1;
    r=ptr[MB_M_R]; im=ptr[MB_M_I];
    sum+=(-ptr[MB_M_ALPHA]*r-ptr[MB_M_OMEGA]*im)*weights[i];
    rr=ptr[MB_M_ROT_R]; ri=ptr[MB_M_ROT_I];
    nr=(r*rr-im*ri)*damper;
    ni=(r*ri+im*rr)*damper;
    ptr[MB_M_R]=nr; ptr[MB_M_I]=ni;
    ptr+=MB_MODE_STRIDE; i+=1;
    r=ptr[MB_M_R]; im=ptr[MB_M_I];
    sum+=(-ptr[MB_M_ALPHA]*r-ptr[MB_M_OMEGA]*im)*weights[i];
    rr=ptr[MB_M_ROT_R]; ri=ptr[MB_M_ROT_I];
    nr=(r*rr-im*ri)*damper;
    ni=(r*ri+im*rr)*damper;
    ptr[MB_M_R]=nr; ptr[MB_M_I]=ni;
    ptr+=MB_MODE_STRIDE; i+=1;
    r=ptr[MB_M_R]; im=ptr[MB_M_I];
    sum+=(-ptr[MB_M_ALPHA]*r-ptr[MB_M_OMEGA]*im)*weights[i];
    rr=ptr[MB_M_ROT_R]; ri=ptr[MB_M_ROT_I];
    nr=(r*rr-im*ri)*damper;
    ni=(r*ri+im*rr)*damper;
    ptr[MB_M_R]=nr; ptr[MB_M_I]=ni;
    ptr+=MB_MODE_STRIDE; i+=1;
  );
  loop(count%4,
    r=ptr[MB_M_R]; im=ptr[MB_M_I];
    sum+=(-ptr[MB_M_ALPHA]*r-ptr[MB_M_OMEGA]*im)*weights[i];
    rr=ptr[MB_M_ROT_R]; ri=ptr[MB_M_ROT_I];
    nr=(r*rr-im*ri)*damper;
    ni=(r*ri+im*rr)*damper;
    ptr[MB_M_R]=nr; ptr[MB_M_I]=ni;
    ptr+=MB_MODE_STRIDE; i+=1;
  );
  sum;
);

function mb_modal_render(base, weights, count, damper)
global()
( mb_modal_render_continue(base, weights, count, damper, 0); );

function mb_modal_retire(st)
local(remaining, scan, sp)
global(MB_M_I, MB_M_R, MB_MODE_STRIDE, MB_S_ACTIVE, MB_S_COUNT, MB_S_SLEEP)
(
  st[MB_S_SLEEP]+=1;
  st[MB_S_SLEEP]>=2048 ? (
    st[MB_S_SLEEP]=0; remaining=0; scan=0;
    loop(st[MB_S_COUNT],
      sp=st[MB_S_ACTIVE]+scan*MB_MODE_STRIDE;
      remaining+=abs(sp[MB_M_R])+abs(sp[MB_M_I]); scan+=1;
    );
    remaining<0.0000000000001 ? st[MB_S_COUNT]=0;
  );
);

// ---- transfer ----
// Shared modal span operator. This is not a moving-contact solver.
function mb_span_projection(m, n, old_length, new_length)
local(overlap, a, b, endpoint, sign)
global()
(
  overlap=min(old_length, new_length);
  a=n*$pi/old_length; b=m*$pi/new_length;
  endpoint=old_length>new_length ? sin(a*new_length) : 0;
  sign=(m&1) ? 1 : -1;
  overlap/new_length*(mb_sinc((a-b)*overlap)-mb_sinc((a+b)*overlap))
    -endpoint*2*sign/(m*$pi);
);
