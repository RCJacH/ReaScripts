// Momentary articulation notes; CC nonzero enables, zero releases.
// MIDI Tap inputs are classified here; events/performance resolve their style.
@init
// Explicit momentary articulations override the selected Tapping style.
// Style selection supplies full gesture amount; playing velocity still applies.
function mb_art_tap_value(channel)
local(scope)
global(MB_A_KIND, MB_A_VALUE, MB_ROLE_TAP, MB_STYLE_TAP)
(
  scope=mb_art_scope(channel);
  scope[MB_A_KIND]==MB_ROLE_TAP ? scope[MB_A_VALUE] :
    scope[MB_A_KIND]==0 && mb_performance_style_current(channel)==MB_STYLE_TAP ? 127 : 0;
);

function mb_art_channel(channel, kind)
(
  kind >= MB_ROLE_FORCE_FIRST ? mb_force_channel(channel, kind) :
  (kind == MB_ROLE_HARMONIC ? MB_ART_HARMONIC_CHANNELS : kind == MB_ROLE_TAP ? MB_ART_TAP_CHANNELS : kind == MB_ROLE_GHOST ? MB_ART_GHOST_CHANNELS : kind == MB_ROLE_HOPO ?
    MB_ART_HO_CHANNELS : MB_ART_CHANNELS) + channel * MB_ART_CHANNEL_WORDS;
);

function mb_art_mapping(kind)
( kind == MB_ROLE_HARMONIC ? harmonic_mapping_current : kind == MB_ROLE_TAP ? tap_mapping_current : kind == MB_ROLE_GHOST ? ghost_mapping_current :
  kind == MB_ROLE_HOPO ? hopo_mapping_current : art_mapping_current; );

// Latest still-active action/channel wins, including CC; release restores a hold.
function mb_art_refresh()
local(channel, kind, entry, newest, scope)
global(MB_ARTICULATION, MB_A_VALUE, MB_A_KIND, MB_A_SOURCE_CHANNEL,
       MB_ROLE_LEGATO, MB_CHANNELS, MB_AC_VALUE, MB_AC_STAMP, MB_ART_KINDS,
       MB_ART_SCOPES, MB_ART_SCOPE_WORDS, MB_A_STAMP)
(
  newest = 0;
  memset(MB_ART_SCOPES, 0, MB_CHANNELS*MB_ART_SCOPE_WORDS);
  MB_ARTICULATION[MB_A_VALUE] = MB_ARTICULATION[MB_A_KIND] = 0;
  MB_ARTICULATION[MB_A_SOURCE_CHANNEL] = -1;
  kind = MB_ROLE_LEGATO;
  loop(MB_ART_KINDS,
    channel = 0;
    loop(MB_CHANNELS,
      entry = mb_art_channel(channel, kind);
      scope=MB_ART_SCOPES+channel*MB_ART_SCOPE_WORDS;
      entry[MB_AC_VALUE]>0 && entry[MB_AC_STAMP]>scope[MB_A_STAMP] ? (
        scope[MB_A_STAMP]=entry[MB_AC_STAMP];
        scope[MB_A_KIND]=kind; scope[MB_A_VALUE]=entry[MB_AC_VALUE];
      );
      entry[MB_AC_VALUE] > 0 && entry[MB_AC_STAMP] > newest ? (
        newest = entry[MB_AC_STAMP];
        MB_ARTICULATION[MB_A_VALUE] = entry[MB_AC_VALUE];
        MB_ARTICULATION[MB_A_KIND] = kind;
        MB_ARTICULATION[MB_A_SOURCE_CHANNEL] = channel;
      );
      channel += 1;
    );
    kind += 1;
  );
);

function mb_art_stamp()
global(MB_ARTICULATION, MB_A_STAMP, MB_SERIAL_MAX, MB_FAULT_COUNTER)
(
  MB_ARTICULATION[MB_A_STAMP] >= MB_SERIAL_MAX ? mb_notes_fault(MB_FAULT_COUNTER) :
    MB_ARTICULATION[MB_A_STAMP] += 1;
  MB_ARTICULATION[MB_A_STAMP];
);

function mb_art_clear()
(
  // Shared precedence stays monotonic while independent Force holds survive.
  // Instrument/MIDI reset clears the counter through mb_notes_reset().
  MB_ARTICULATION[MB_A_VALUE] = MB_ARTICULATION[MB_A_KIND] = 0;
  MB_ARTICULATION[MB_A_SOURCE_CHANNEL] = -1;
  MB_ARTICULATION[MB_A_SWITCHES] = 0;
  memset(MB_ART_CHANNELS, 0, MB_CHANNELS * MB_ART_CHANNEL_WORDS);
  memset(MB_ART_HO_CHANNELS, 0, MB_CHANNELS * MB_ART_CHANNEL_WORDS);
  memset(MB_ART_GHOST_CHANNELS, 0, MB_CHANNELS * MB_ART_CHANNEL_WORDS);
  memset(MB_ART_TAP_CHANNELS, 0, MB_CHANNELS * MB_ART_CHANNEL_WORDS);
  memset(MB_ART_HARMONIC_CHANNELS, 0, MB_CHANNELS * MB_ART_CHANNEL_WORDS);
  memset(MB_ART_SCOPES, 0, MB_CHANNELS * MB_ART_SCOPE_WORDS);
);

function mb_art_init()
(
  art_channel_current = art_channel_request = mb_clamp(floor(p_keyswitch_channel), 0, MB_KS_FOLLOW_CHANNEL);
  art_mode_current=channel_mode_current;
  art_mapping_current = art_mapping_request = mb_midi_mapping_index(p_legato_slide_controller, MB_NOTE_CC_MAX);
  hopo_mapping_current = hopo_mapping_request = mb_midi_mapping_index(p_ho_po_controller, MB_NOTE_CC_MAX);
  ghost_mapping_current = ghost_mapping_request = mb_midi_mapping_index(p_ghost_controller, MB_NOTE_CC_MAX);
  tap_mapping_current = tap_mapping_request = mb_midi_mapping_index(p_tapping_style_controller, MB_NOTE_CC_MAX);
  harmonic_mapping_current = harmonic_mapping_request = mb_midi_mapping_index(p_harmonics_controller, MB_NOTE_CC_MAX);
  mb_art_clear();
);

function mb_art_apply_requests()
(
  art_mode_current!=channel_mode_current ||
  art_channel_current != art_channel_request || art_mapping_current != art_mapping_request ||
  hopo_mapping_current != hopo_mapping_request || ghost_mapping_current != ghost_mapping_request ||
  tap_mapping_current != tap_mapping_request || harmonic_mapping_current != harmonic_mapping_request ? (
    art_channel_current = art_channel_request;
    art_mode_current=channel_mode_current;
    art_mapping_current = art_mapping_request;
    hopo_mapping_current = hopo_mapping_request;
    ghost_mapping_current = ghost_mapping_request;
    tap_mapping_current = tap_mapping_request;
    harmonic_mapping_current = harmonic_mapping_request;
    mb_art_clear();
  );
);

// Force inputs are independent overrides; identical inputs prefer Force,
// then Harmonic, Tap, Ghost, HO/PO, Legato.
function mb_art_matches(channel, note)
local(forced)
(
  mb_control_channel_matches(channel, art_channel_current) ? (
    forced=mb_force_matches(note);
    forced ? forced :
    harmonic_mapping_current < 128 && note == harmonic_mapping_current ? MB_ROLE_HARMONIC :
    tap_mapping_current < 128 && note == tap_mapping_current ? MB_ROLE_TAP :
    ghost_mapping_current < 128 && note == ghost_mapping_current ? MB_ROLE_GHOST :
    hopo_mapping_current < 128 && note == hopo_mapping_current ? MB_ROLE_HOPO :
    art_mapping_current < 128 && note == art_mapping_current ? MB_ROLE_LEGATO : 0;
  ) : 0;
);

function mb_art_cc_selected(controller)
global(p_legato_slide_controller, p_ho_po_controller, p_ghost_controller, p_tapping_style_controller,
       p_harmonics_controller)
(
  mb_midi_cc_supported(controller) && (
    (p_legato_slide_controller >= 128 && controller == floor(p_legato_slide_controller) - 127) ||
    (p_ho_po_controller >= 128 && controller == floor(p_ho_po_controller) - 127) ||
    (p_ghost_controller >= 128 && controller == floor(p_ghost_controller) - 127) ||
    (p_tapping_style_controller >= 128 && controller == floor(p_tapping_style_controller) - 127) ||
    (p_harmonics_controller >= 128 && controller == floor(p_harmonics_controller) - 127));
);

function mb_art_note_on(channel, note, velocity, kind)
local(record, entry)
global(MB_N_ROLE, MB_N_ACTIVE, MB_AC_TOKEN, MB_N_SERIAL,
       MB_AC_STAMP, MB_AC_VALUE, MB_ARTICULATION, MB_A_SWITCHES, MB_ROLE_FORCE_FIRST)
(
  record = mb_notes_begin(channel, note, velocity);
  record >= 0 ? (
    mb_note_ptr(record)[MB_N_ROLE] = kind;
    mb_note_ptr(record)[MB_N_ACTIVE] = 1;
    entry = mb_art_channel(channel, kind);
    entry[MB_AC_TOKEN] = mb_note_ptr(record)[MB_N_SERIAL];
    entry[MB_AC_STAMP] = mb_art_stamp();
    entry[MB_AC_VALUE] = velocity;
    MB_ARTICULATION[MB_A_SWITCHES] += 1;
    kind >= MB_ROLE_FORCE_FIRST ? mb_force_refresh() : mb_art_refresh();
  );
);

function mb_art_note_off(channel, token, kind)
local(entry)
global(MB_AC_TOKEN, MB_ART_CHANNEL_WORDS, MB_ROLE_FORCE_FIRST)
(
  entry = mb_art_channel(channel, kind);
  entry[MB_AC_TOKEN] == token ? (
    memset(entry, 0, MB_ART_CHANNEL_WORDS);
    kind >= MB_ROLE_FORCE_FIRST ? mb_force_refresh() : mb_art_refresh();
  );
);

function mb_art_controller(channel, controller, value)
local(kind, entry, mapping)
global(MB_ROLE_LEGATO, MB_ART_CHANNEL_WORDS, MB_AC_TOKEN, art_channel_current,
       MB_AC_STAMP, MB_AC_VALUE, MB_ARTICULATION, MB_A_SWITCHES, MB_ART_KINDS,
       MB_ROLE_TAP)
(
  kind = MB_ROLE_LEGATO;
  loop(MB_ART_KINDS,
    entry = mb_art_channel(channel, kind);
    mapping = mb_art_mapping(kind);
    controller == 120 || (controller == 123 && entry[MB_AC_TOKEN] > 0) ?
      memset(entry, 0, MB_ART_CHANNEL_WORDS);
    mb_midi_cc_supported(controller) &&
    kind!=MB_ROLE_TAP &&
    mb_control_channel_matches(channel, art_channel_current) &&
    mapping >= 128 && controller == mapping - 127 ? (
      entry[MB_AC_TOKEN] = -1;
      entry[MB_AC_STAMP] = value > 0 ? mb_art_stamp() : 0;
      entry[MB_AC_VALUE] = value;
      MB_ARTICULATION[MB_A_SWITCHES] += 1;
    );
    kind += 1;
  );
  controller == 120 || controller == 123 ? mb_force_release_channel(channel);
  mb_art_refresh();
);
