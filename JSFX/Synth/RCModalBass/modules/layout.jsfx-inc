// Memory ABI v32: coupled fretless contact uses spare per-string RAM.
@init
// Imported @init contributes functions, not executable initialization.
// Call explicitly from the instrument's @init adapter.
function mb_layout_init()
(
  MB_MAX_MODES=256;
  MB_MODE_STRIDE=8;
  MB_M_R=0; MB_M_I=1; MB_M_ROT_R=2; MB_M_ROT_I=3;
  MB_M_ALPHA=4; MB_M_OMEGA=5; MB_M_INITIAL=6; MB_M_FREQ=7;

  MB_S_ACTIVE=0; MB_S_PREVIOUS=1;
  MB_S_COUNT=2; MB_S_PREVIOUS_COUNT=3; MB_S_PREVIOUS_LEFT=4;
  MB_S_MUTE=5; MB_S_NOTE=6; MB_S_CHANNEL=7; MB_S_SLEEP=8;
  MB_S_VELOCITY=9; MB_S_TAIL_SAMPLES=10;
  MB_S_LENGTH_A=11; MB_S_LENGTH_B=12;
  MB_S_F1=13;
  MB_S_HARMONIC=14; // 0 = ordinary; 2..8 = captured ideal-touch partial.
  MB_HEADER_WORDS=16;
  // MB_C_* logical fields; slot 0 stores construction relative to Roundwound.
  MB_CONFIG=MB_HEADER_WORDS; MB_CONFIG_WORDS=29;
  MB_GEOMETRY=MB_CONFIG+MB_CONFIG_WORDS;
  MB_G_LENGTH=0; MB_G_P=1; MB_G_WIDTH=2; MB_G_F1=3;
  MB_G_STIFFNESS=4; MB_G_AGE=5; MB_G_PALM=6; MB_G_END_LOSS=7;
  MB_GEOMETRY_WORDS=8;
  MB_BANK_A=MB_GEOMETRY+MB_GEOMETRY_WORDS;
  MB_BANK_B=MB_BANK_A+MB_MAX_MODES*MB_MODE_STRIDE;
  // Observation weights never share modal RAM.
  MB_PICKUP_A=MB_BANK_B+MB_MAX_MODES*MB_MODE_STRIDE;
  MB_PICKUP_B=MB_PICKUP_A+MB_MAX_MODES;
  MB_ELECTRONICS=MB_PICKUP_B+MB_MAX_MODES;
  MB_E_ENABLED=0; MB_E_B0=1; MB_E_B1=2; MB_E_B2=3;
  MB_E_A1=4; MB_E_A2=5; MB_E_X1=6; MB_E_X2=7;
  MB_E_Y1=8; MB_E_Y2=9;
  MB_ELECTRONICS_WORDS=10;
  MB_V1_WORDS=MB_ELECTRONICS+MB_ELECTRONICS_WORDS;
  MB_LIVE=MB_V1_WORDS; MB_LIVE_WORDS=32;
  MB_L_FRET=0; MB_L_BEND=1; MB_L_FRET_TARGET=2; MB_L_BEND_TARGET=3;
  MB_L_BEND_LEFT=4; MB_L_CLOCK=5;
  // Gesture flags and ghost damping use former reserves; no region grows.
  MB_L_GESTURE_REQUEST=6; MB_L_JOB_GESTURE=9;
  MB_L_GHOST_DAMP=10; MB_L_GHOST_AMOUNT=26;
  MB_L_JOB=7; MB_L_JOB_FRET=8;
  MB_L_JOB_SOURCE_COUNT=11; MB_L_JOB_COUNT=12; MB_L_JOB_LENGTH=13;
  MB_L_FADE_KIND=14; MB_L_FADE_TOTAL=15; MB_L_DURATION=16;
  MB_L_FLAG_A=17; MB_L_FLAG_B=18; MB_L_MASK_SMOOTH=19;
  MB_L_ENERGY_BEFORE=20; MB_L_ENERGY_RAW=21; MB_L_ENERGY_AFTER=22;
  MB_L_ENERGY_SCALE=23; MB_L_COMMITS=24; MB_L_PAIRS_THIS_SAMPLE=25;
  MB_L_JOB_DURATION=27; MB_L_HAS_CONFIG=28;
  MB_L_DAMP_DB=29; MB_L_DAMP_LEFT=30; MB_L_MOTION_RATE=31;
  MB_L_CFG=MB_LIVE+MB_LIVE_WORDS;
  MB_L_STAGE_CFG=MB_L_CFG+MB_CONFIG_WORDS;
  MB_L_STAGE_G=MB_L_STAGE_CFG+MB_CONFIG_WORDS;
  MB_MASK_A=MB_L_STAGE_G+MB_GEOMETRY_WORDS;
  MB_MASK_B=MB_MASK_A+MB_MAX_MODES;
  MB_MASK_TARGET_A=MB_MASK_B+MB_MAX_MODES;
  MB_MASK_TARGET_B=MB_MASK_TARGET_A+MB_MAX_MODES;
  MB_TAPER_A=MB_MASK_TARGET_B+MB_MAX_MODES;
  MB_TAPER_B=MB_TAPER_A+MB_MAX_MODES;
  // Keep later addresses stable; the former 256x256 matrix supplies spare RAM.
  MB_UNUSED_SPAN_WORDS=MB_MAX_MODES*MB_MAX_MODES;
  // Repluck scratch occupies 528 words of the former matrix; no offsets move.
  MB_REPLUCK=MB_TAPER_B+MB_MAX_MODES; MB_RP_HEADER_WORDS=16;
  MB_RP_COUNT=0; MB_RP_BEFORE=1; MB_RP_FOLDED=2; MB_RP_MAPPED=3;
  MB_RP_CARRY=4; MB_RP_PLUCK=5; MB_RP_WORK=6; MB_RP_AFTER=7;
  MB_RP_MAP_SCALE=8; MB_RP_EXCITE_SCALE=9; MB_RP_GRIP=10; MB_RP_FOLD_SCALE=11;
  MB_RP_CORRECTION=12; MB_RP_LEFT=13; MB_RP_TOTAL=14;
  MB_RP_RESPONSE_CORRECTION=15;
  MB_RP_Q=MB_RP_HEADER_WORDS; MB_RP_V=MB_RP_Q+MB_MAX_MODES;
  MB_REPLUCK_WORDS=MB_RP_V+MB_MAX_MODES;
  // Averaged stretching, two 64-word bank records in the unused matrix reserve.
  MB_TENSION=MB_REPLUCK+MB_REPLUCK_WORDS; MB_AT_WORDS=64;
  MB_AT_AMOUNT=0; MB_AT_DELTA=1; MB_AT_CLOCK=2; MB_AT_STRAIN=3;
  MB_AT_WORK_PENDING=4; MB_AT_GHOST=5; MB_AT_EA=6;
  MB_AT_BEFORE=7; MB_AT_AFTER=8; MB_AT_WORK=9; MB_AT_SCALE=10;
  MB_AT_UPDATES=11; MB_AT_REBASE=12; MB_AT_LIMITED=13;
  MB_AT_CFG=16; MB_AT_G=MB_AT_CFG+MB_CONFIG_WORDS;
  MB_TENSION_INTERVAL=64; MB_TENSION_MAX_RATIO=0.25;
  MB_WOUND_CORE_RATIO=0.25; // Uncalibrated axial core/outer-diameter assumption.
  MB_OUTPUT=MB_TENSION+2*MB_AT_WORDS; MB_OUTPUT_WORDS=2;
  MB_OUT_CURRENT=0; MB_OUT_TARGET=1; // Linear gain minus one; 0 dB leaves zero RAM.
  MB_ACTION=MB_OUTPUT+MB_OUTPUT_WORDS; MB_ACTION_WORDS=8;
  MB_ACT_HEIGHT=0; // mm relative to 2 mm; words 1-7 reserved (former noise gate).
  // Linear pickup observation, entirely inside the unused span-matrix reserve.
  // Combined A/B weights retain their original addresses and render arithmetic.
  MB_PICKUP_STATE=MB_ACTION+MB_ACTION_WORDS; MB_PU_HEADER_WORDS=16;
  MB_PU_REVISION=0; MB_PU_POSITION1=1; MB_PU_WIDTH1=2; MB_PU_GAIN1=3;
  MB_PU_POSITION2=4; MB_PU_WIDTH2=5; MB_PU_GAIN2=6;
  MB_PU_MIX=7; MB_PU_POLARITY=8;
  MB_PU_AUX=9; MB_PU_AUX_TARGET=10; MB_PU_AUX_LEFT=11;
  MB_PU_UPDATES=12; MB_PU_CONFIGURED=13;
  MB_PU_GATE=14; MB_PU_GATE_TARGET=15;
  MB_PU_A=16; MB_PU_B=20; MB_PU_BANK_WORDS=4;
  MB_PUB_COUNT=0; MB_PUB_LENGTH=1; MB_PUB_LEFT=2; MB_PUB_OPEN_LENGTH=3;
  MB_PU_TARGET_A=MB_PICKUP_STATE+24;
  MB_PU_TARGET_B=MB_PU_TARGET_A+MB_MAX_MODES;
  MB_PU_1_A=MB_PU_TARGET_B+MB_MAX_MODES;
  MB_PU_2_A=MB_PU_1_A+MB_MAX_MODES;
  MB_PU_1_B=MB_PU_2_A+MB_MAX_MODES;
  MB_PU_2_B=MB_PU_1_B+MB_MAX_MODES;
  MB_PICKUP_STATE_WORDS=24+6*MB_MAX_MODES;
  // Static height observation; no vibration/configuration addresses move.
  // Distances are offsets from 3 mm; action is an offset from 2 mm.
  MB_PICKUP_HEIGHT=MB_PICKUP_STATE+MB_PICKUP_STATE_WORDS;
  MB_PH_DISTANCE1=0; MB_PH_DISTANCE2=1; MB_PH_ACTION=2;
  MB_PH_A=4; MB_PH_B=8; MB_PH_BANK_WORDS=4; MB_PICKUP_HEIGHT_WORDS=12;
  MB_PHB_GAP1=0; MB_PHB_GAP2=1; MB_PHB_GAIN1=2; MB_PHB_GAIN2=3;
  MB_PICKUP_FIELD_DEPTH=2; // mm, approximate finite-field falloff length.
  MB_PICKUP_MAX_HEIGHT_GAIN=6.25;
  // Matched-coil observation. Existing pickup/string addresses are retained.
  MB_PICKUP_COILS=MB_PICKUP_HEIGHT+MB_PICKUP_HEIGHT_WORDS;
  MB_PC_MODE1=0; MB_PC_MODE2=1; MB_PC_SPACING1=2; MB_PC_SPACING2=3;
  MB_PC_STAGGER1=4; MB_PC_STAGGER2=5; MB_PC_STRINGS=6;
  MB_PC_HEADER_WORDS=8; MB_PC_A=8; MB_PC_B=40;
  MB_COIL_WORDS=8; MB_COILS_PER_BANK=4; MB_PICKUP_COILS_WORDS=72;
  MB_CO_POSITION=0; MB_CO_Q=1; MB_CO_WIDTH=2; MB_CO_COVERAGE=3;
  MB_CO_GAP=4; MB_CO_HEIGHT=5; MB_CO_GAIN=6;
  MB_COIL_SINGLE=0; MB_COIL_SPLIT=1;
  MB_COIL_SERIES=3; MB_COIL_PARALLEL=4;
  // Linearized magnetic force; separate from electrical observation.
  MB_MAGNET=MB_PICKUP_COILS+MB_PICKUP_COILS_WORDS;
  MB_MG_HEADER=8; MB_MG_FORCE1=0; MB_MG_FORCE2=1; MB_MG_REVISION=2; MB_MG_ACTION=3; MB_MG_BUSY=4;
  MB_MG_BANK_WORDS=1040; MB_MG_A=8; MB_MG_B=MB_MG_A+MB_MG_BANK_WORDS;
  MB_MGB_LENGTH=0; MB_MGB_OPEN=1; MB_MGB_MASS=2; MB_MGB_COUNT=3;
  MB_MGB_ON=4; MB_MGB_LEFT=5; MB_MGB_CLOCK=6; MB_MGB_UPDATES=7;
  MB_MGB_LIMITED=8; MB_MGB_WORK=9;
  MB_MGB_OMEGA=16; MB_MGB_FREQ=MB_MGB_OMEGA+MB_MAX_MODES;
  MB_MGB_CURRENT=MB_MGB_FREQ+MB_MAX_MODES; MB_MGB_TARGET=MB_MGB_CURRENT+MB_MAX_MODES;
  MB_MAGNET_WORDS=MB_MG_HEADER+2*MB_MG_BANK_WORDS;
  MB_MAGNET_INTERVAL=64; MB_MAGNET_SMOOTH_MS=10;
  MB_MAGNET_MAX_FRACTION=0.1; MB_MAGNET_FIELD_DEPTH=2; // mm; uncalibrated field law.
  // Circuit observation occupies former matrix reserve; physical stride stays fixed.
  MB_CIR_PICKUP=MB_MAGNET+MB_MAGNET_WORDS; MB_CP_WORDS=1040;
  MB_CP_A_OUTPUT1=0; MB_CP_A_OUTPUT2=1; MB_CP_B_OUTPUT1=2; MB_CP_B_OUTPUT2=3;
  MB_CP_OUTPUT1=4; MB_CP_OUTPUT2=5; MB_CP_A1=16;
  // Centered pole/rail observation, in former matrix reserve. Widths offset
  // the 6-mm reference so default observation retains the previous RAM image.
  MB_PICKUP_FIELD=MB_CIR_PICKUP+MB_CP_WORDS; MB_PICKUP_FIELD_WORDS=4;
  MB_PF_GEOMETRY1=0; MB_PF_GEOMETRY2=1; MB_PF_WIDTH1=2; MB_PF_WIDTH2=3;
  MB_POLE_POLES=0; MB_POLE_RAIL=1; MB_PICKUP_REFERENCE_FIELD_WIDTH=6;
  // Optional nonlinear observation: no synthesis/ownership addresses move.
  MB_PICKUP_NL=MB_PICKUP_FIELD+MB_PICKUP_FIELD_WORDS;
  MB_NL_AMOUNT=0; MB_NL_TARGET=1; MB_NL_LEFT=2; MB_NL_ON=3; MB_NL_CONFIGURED=4;
  MB_NL_FIR=8; MB_NL_TAPS=64; MB_NL_OVERSAMPLE=4;
  MB_NL_A=MB_NL_FIR+MB_NL_TAPS; MB_NL_BANK_WORDS=2384; MB_NL_B=MB_NL_A+MB_NL_BANK_WORDS;
  MB_PICKUP_NL_WORDS=MB_NL_B+MB_NL_BANK_WORDS;
  MB_NLB_COUNT=0; MB_NLB_LEFT=1; MB_NLB_CURSOR=2; MB_NLB_OUTPUT1=3; MB_NLB_OUTPUT2=4;
  MB_NLB_WEIGHTS=16; MB_NLB_TARGETS=MB_NLB_WEIGHTS+4*MB_MAX_MODES;
  MB_NLB_COILS=MB_NLB_TARGETS+4*MB_MAX_MODES;
  MB_NLC_WORDS=80; MB_NLC_GAIN=0; MB_NLC_DEPTH=1; MB_NLC_POLE=2;
  MB_NLC_GAIN_TARGET=3; MB_NLC_DEPTH_TARGET=4; MB_NLC_POLE_TARGET=5;
  MB_NLC_Q=6; MB_NLC_V=7; MB_NLC_VALID=8; MB_NLC_RING=9;
  MB_NL_BAND_FULL=0.12; MB_NL_BAND_STOP=0.18;
  MB_NL_FREQ_FULL=MB_NL_BAND_FULL*srate; MB_NL_FREQ_STOP=MB_NL_BAND_STOP*srate;
  MB_NL_FREQ_SCALE=1/(MB_NL_FREQ_STOP-MB_NL_FREQ_FULL);
  MB_PICKUP_SMOOTH_MS=5;
  MB_FRETBOARD_FRETS=24;
  fret_count_current=fret_count_request=min(24, max(12, floor(p_fret_count)));
  MB_FRETBOARD_END_RATIO=2^(-(MB_FRETBOARD_FRETS+1)/12);
  MB_BEND_DAMP_A=MB_TAPER_B+MB_MAX_MODES+MB_UNUSED_SPAN_WORDS;
  MB_BEND_DAMP_B=MB_BEND_DAMP_A+MB_MAX_MODES;
  MB_CONTACT=MB_BEND_DAMP_B+MB_MAX_MODES; MB_CONTACT_WORDS=32;
  MB_K_AMOUNT=0; MB_K_STIFFNESS=1; MB_K_DAMPING=2; MB_K_SURFACE=3;
  MB_K_LEVEL=4; MB_K_LEVEL_TARGET=5; MB_K_LEVEL_INITIALIZED=6;
  MB_CONTACT_LEVEL_SMOOTH=1-exp(-1/(0.005*srate));
  // Retain stable physical instance addresses; removed texture RAM is spare.
  MB_STRING_WORDS=91145;
  MB_FRET_NEXT_RATIO=2^(-1/12); MB_CONTACT_SOFT_DISTANCE=0.00005;
  // Fretless: one finite board patch on the speaking side of the finger.
  // Only this modal prefix couples to it; upper modes keep their free update.
  MB_BOARD_CONTACT_MODES=16; MB_BOARD_CONTACT_FADE_MODES=4;
  MB_BOARD_CONTACT_DISTANCE=0.012;
  MB_BOARD_CONTACT_WIDTH=0.008;
  // Collapsed finger/board patch: quadratic N/m^2, relative to the K control.
  // 80000 = 1 / 12.5 um: K is secant stiffness at that reference penetration.
  // These are reduced-model voicings, not measured tissue/wood properties.
  MB_BOARD_SKIN_K=80000; MB_BOARD_K=80000;
  MB_BOARD_CONTACT_C_SCALE=0.25; MB_BOARD_SOLVE_STEPS=12;
  MB_BOARD_DAMP_SOFT=0.00001;
  MB_CONTROL_INTERVAL=32; MB_PROJECTION_BUDGET=64;
  // Scratch allowance: direct engine calls get 64; the rack shares 64 total.
  mb_preparation_allowance=MB_PROJECTION_BUDGET;
  mb_rack_prepare_pending=0;
  MB_BEND_DAMP_DEFAULT=0.6;
  MB_EVENT_LIMIT=4096; MB_EVENT_STRIDE=4;
  MB_EV_OFFSET=0; MB_EV_STATUS=1; MB_EV_DATA1=2; MB_EV_DATA2=3;
  MB_EV_NOTE=MB_EV_DATA1; MB_EV_VELOCITY=MB_EV_DATA2;
  // Rack ABI v1. All six physical bases are permanent; engine ABI v6 unchanged.
  MB_MAX_STRINGS=6;
  MB_RACK=MB_MAX_STRINGS*MB_STRING_WORDS; MB_RACK_HEADER_WORDS=16;
  MB_R_COUNT=0; MB_R_PRESET=1; MB_R_PREP_CURSOR=2;
  MB_R_PAIRS=3; MB_R_RENDERED=4; MB_R_ACTIVE=5; MB_R_PENDING=6;
  MB_R_LAST_ROUTE=7; // Stable ID for Auto manual gestures/selected telemetry.
  MB_R_SHARED_WHEEL=8; // Last wheel in Single channel mode, centered at 8192.
  // Hand v1 uses the seven spare rack header words; physical addresses stay fixed.
  MB_FINGERING_LOW_POSITION=0; MB_FINGERING_EASY=1; MB_FINGERING_NEAREST=2;
  MB_FINGERING_LOCK_POSITION=3;
  MB_OPEN_FRETTED_FIRST=0; MB_OPEN_PREFER_LOW=1; MB_OPEN_PREFER_HIGH=2; MB_OPEN_PREFER_ALL=3;
  // Easy costs in fret-equivalent units, evaluated only for note allocation.
  MB_EASY_SHIFT_COST=4; MB_EASY_SPAN_COST=0.5; MB_EASY_STRING_COST=0.5;
  MB_R_HAND_START=9; MB_R_HAND_LOW=10; MB_R_HAND_HIGH=11;
  MB_R_HAND_FRETTED=12; MB_R_HAND_OPEN=13; MB_R_HAND_CONFLICT=14; MB_R_HAND_MASK=15;
  MB_RACK_SLOTS=MB_RACK+MB_RACK_HEADER_WORDS; MB_RACK_SLOT_WORDS=16;
  MB_RS_ENABLED=0; MB_RS_RETIRING=1; MB_RS_BUSY=2;
  MB_RS_OPEN=3; MB_RS_FINE=4; MB_RS_REFERENCE=5;
  MB_RS_LATCH_OPEN=6; MB_RS_LATCH_FINE=7; MB_RS_LATCH_REFERENCE=8;
  MB_RS_SOURCE=9; MB_RS_LATCHED=10; MB_RS_PENDING=11;
  MB_RS_RETIRE_LEFT=12; MB_RS_LEVEL=13;
  // Controller fractions survive range edits, including a temporarily zero range.
  MB_RS_BEND_INPUT=14; MB_RS_SLIDE_INPUT=15;
  MB_EVENTS=MB_RACK_SLOTS+MB_MAX_STRINGS*MB_RACK_SLOT_WORDS;
  // MIDI registry ABI v1, appended after the unchanged Stage 3A event queue.
  MB_CHANNELS=16; MB_KEY_COUNT=MB_CHANNELS*128; MB_NOTE_LIMIT=4096;
  MB_NOTE_WORDS=12; MB_OWNER_WORDS=16; MB_CHANNEL_WORDS=4;
  MB_NOTES=MB_EVENTS+MB_EVENT_LIMIT*MB_EVENT_STRIDE; MB_NOTES_HEADER_WORDS=32;
  MB_NH_USED=0; MB_NH_FREE=1; MB_NH_NEXT=2; MB_NH_SERIAL=3;
  MB_NH_FAULT=4; MB_NH_FAULT_COUNT=5; MB_NH_FAULT_SILENCED=6;
  MB_NH_PEAK=7; MB_NH_ACCEPTED=8; MB_NH_REJECTED=9; MB_NH_ORPHAN_OFFS=10;
  MB_NH_RETIRED=11; MB_NH_OFFS=12; MB_NH_RESETS=13; MB_NH_QUEUE_DROPS=14;
  MB_NH_BENDS=15;
  MB_NH_OFF_ROLE=16; MB_NH_OFF_SERIAL=17; MB_NH_OFF_VALID=18;
  MB_FAULT_POOL=1; MB_FAULT_QUEUE=2; MB_FAULT_ORDER=3; MB_FAULT_COUNTER=4;
  MB_SERIAL_MAX=4503599627370495;
  MB_KEY_HEADS=MB_NOTES+MB_NOTES_HEADER_WORDS;
  MB_KEY_TAILS=MB_KEY_HEADS+MB_KEY_COUNT;
  MB_NOTE_RECORDS=MB_KEY_TAILS+MB_KEY_COUNT;
  MB_N_SERIAL=0; MB_N_CHANNEL=1; MB_N_PITCH=2; MB_N_VELOCITY=3;
  MB_N_STRING=4; MB_N_GENERATION=5; MB_N_EPOCH=6; MB_N_ACTIVE=7;
  MB_N_NEXT=8; MB_N_REASON=9; MB_N_ALLOCATED=10;
  MB_N_ROLE=11; MB_ROLE_NOTE=0; MB_ROLE_LEGATO=1; MB_ROLE_HOPO=2; MB_ROLE_GHOST=3;
  MB_ROLE_TAP=4; MB_ROLE_HARMONIC=5; MB_ART_KINDS=5;
  MB_ROLE_FORCE_FIRST=6; // Roles 6..11 = Strings 1..6; separate from articulation.
  MB_ROLE_LET_RING=12; // Independent momentary release gate; not an articulation kind.
  MB_MIDI_PLAYING_OFFSET=-12; // Sound one octave below playing keys; switches stay literal.
  MB_REJECT_NONE=0; MB_REJECT_ROUTING=1; MB_REJECT_DISABLED=2;
  MB_REJECT_CHANNEL=3;
  MB_OWNERS=MB_NOTE_RECORDS+MB_NOTE_LIMIT*MB_NOTE_WORDS;
  MB_O_GENERATION=0; MB_O_SERIAL=1; MB_O_RECORD=2; MB_O_PITCH=3;
  MB_O_KEY_DOWN=4; MB_O_SOURCE_CHANNEL=5; MB_O_BEND_CHANNEL=6;
  MB_O_STATE=7; MB_O_EPOCH=8; MB_O_VELOCITY=9;
  MB_O_MIDI_BEND=10; MB_O_WHEEL_NORMAL=11; MB_O_BEND_CLIPPED=12;
  MB_O_FRET_ANCHOR=13; MB_O_MIDI_SLIDE=14; MB_O_SLIDE_CLIPPED=15;
  // BEND_CHANNEL: -1 = detached, 0..15 = controller channel, 16 = shared part.
  MB_BEND_SHARED=16; MB_BEND_MIN=-12; MB_BEND_MAX=12;
  MB_VOICE_QUIET=0; MB_VOICE_HELD=1; MB_VOICE_RINGING=2; MB_VOICE_DAMPING=3;
  MB_CHANNEL_STATE=MB_OWNERS+MB_MAX_STRINGS*MB_OWNER_WORDS;
  MB_CH_EPOCH=0; MB_CH_WHEEL=1; MB_CH_RELEASES=2; MB_CH_KILLS=3;
  // Controller extension v1, appended without moving physical/registry addresses.
  // Two selected raw inputs per channel plus a shared part; -1 means not received.
  MB_CTRL_WHEEL=0; MB_CTRL_PRESSURE=1; MB_CTRL_CC_FIRST=2; MB_CTRL_LAST=129;
  MB_MIDI_CC_MIN=1; MB_MIDI_CC_MAX=119;
  MB_NOTE_CC_MAX=127+MB_MIDI_CC_MAX;
  MB_PRESSURE_SELECTOR_MAX=128+MB_MIDI_CC_MAX;
  // Wire source IDs keep CC0 at 2. Native selectors omit CC0: CC1 is index 2.
  MB_CTRL_SELECTOR_CC_FIRST=2; MB_CTRL_SELECTOR_LAST=1+MB_MIDI_CC_MAX;
  MB_CTRL_BEND=0; MB_CTRL_SLIDE=1; MB_CTRL_WORDS=2;
  MB_CONTROLLER_INPUTS=MB_CHANNEL_STATE+MB_CHANNELS*MB_CHANNEL_WORDS;
  MB_CONTROLLER_WORDS=(MB_CHANNELS+1)*MB_CTRL_WORDS;
  // Articulation/motion extension v1; all existing physical/registry addresses stay fixed.
  MB_ARTICULATION=MB_CONTROLLER_INPUTS+MB_CONTROLLER_WORDS; MB_ART_WORDS=16;
  // Controller response and structural fades are independent of legato travel.
  // Match the live engine's existing 5-ms minimum; these are not host controls.
  MB_CONTROLLER_SMOOTH_MS=5; MB_FRET_TRANSITION_MS=5;
  MB_MOTION_INTERVAL_MS=5; MB_LEGATO_MAX_MS=2000;
  MB_A_KIND=0; MB_A_STAMP=1; MB_A_HO_RUNNING=2;
  MB_A_VALUE=3;
  MB_A_SWITCHES=4; MB_A_RUNNING=6; MB_A_SLIDES=7; MB_A_FALLBACKS=8;
  MB_A_DURATION=9; MB_A_SOURCE_CHANNEL=10;
  MB_A_HAMMERS=11; MB_A_PULLS=12; MB_A_HO_FALLBACKS=13;
  MB_A_GHOSTS=14;
  MB_A_TAPS=15;
  MB_ART_CHANNELS=MB_ARTICULATION+MB_ART_WORDS; MB_ART_CHANNEL_WORDS=3;
  MB_AC_TOKEN=0; MB_AC_STAMP=1; MB_AC_VALUE=2;
  MB_MOTIONS=MB_ART_CHANNELS+MB_CHANNELS*MB_ART_CHANNEL_WORDS; MB_MOTION_WORDS=8;
  MB_MO_ACTIVE=0; MB_MO_START=1; MB_MO_TARGET=2; MB_MO_CURRENT=3;
  MB_MO_ELAPSED=4; MB_MO_TOTAL=5; MB_MO_CLOCK=6; MB_MO_REQUESTS=7;
  MB_MOTION_SAVE=MB_MOTIONS+MB_MAX_STRINGS*MB_MOTION_WORDS;
  // Append HO/PO activation and gesture state; all older addresses stay fixed.
