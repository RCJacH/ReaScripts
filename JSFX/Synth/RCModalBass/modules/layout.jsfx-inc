  MB_FR_AMOUNT_LEFT=57; MB_FR_AMOUNT_STEP=58;
  MB_FR_CONTROL_LEFT=59; MB_FR_MIX_GAIN=60; MB_FR_AUDIO_ACTIVE=61;
  MB_FR_STEP1=62; MB_FR_STEP2=63;
  MB_FR_ELECTRONICS=64; MB_FR_CONFIG=74;
  // One small spatial-surface record, not an audio voice or sampled waveform.
  MB_FR_SURFACE1=104;
  MB_FR_CTRL_HISTORY=113; // Four (signed travel, elapsed samples) pairs.
  MB_FR_CTRL_SUM_X=121; MB_FR_CTRL_SUM_T=122; MB_FR_CTRL_HEAD=123; MB_FR_CTRL_COUNT=124;
  MB_FR_CTRL_LAST_X=125; MB_FR_CTRL_LAST_TIME=126; MB_FR_CTRL_READY=127;
  MB_FS_CELL=0; MB_FS_YM=1; MB_FS_Y0=2; MB_FS_Y1=3; MB_FS_YP=4;
  MB_FS_A=5; MB_FS_B=6; MB_FS_C=7; MB_FS_READY=8;
  MB_FR_RATE=128; MB_FR_RATE_TARGET=129; MB_FR_TRACK=130; MB_FR_TRACK_TARGET=131;
  MB_FR_FINE=132; MB_FR_FINE_TARGET=133; MB_FR_HP_A=134; MB_FR_HP_TARGET=135;
  MB_FR_LP_HZ=136; MB_FR_LP_TARGET=137; MB_FR_SLIDE_TOKEN=138;
  MB_FR_SQUEAK=139; MB_FR_SQUEAK_TARGET=140;
  MB_FR_BP_G=141; MB_FR_BP_G_TARGET=142; MB_FR_BP_K=143; MB_FR_BP_K_TARGET=144;
  MB_FR_SPEED=145; MB_FR_STEP1_TARGET=146; MB_FR_STEP2_TARGET=147;
  MB_FR_RATE_LEFT=148; MB_FR_STEP1_DELTA=149; MB_FR_STEP2_DELTA=150;
  MB_FR_START_X=151; MB_FR_STARTUP_LEFT=152;
  MB_FR_CTRL_UNTIL=153; MB_FR_CTRL_TARGET=154;
  MB_FR_END_X=155;
  MB_FR_CURVE1=156; MB_FR_CURVE2=157; MB_FR_ACCEL=158; MB_FR_DECEL=159;
  // Friction-only hand curve; no intermittent Legato envelope.
  MB_FRICTION_INTERVAL=max(32, ceil(0.005*srate)); MB_FRICTION_SETTLE=ceil(0.030*srate);
  MB_FRICTION_FAST_INTERVAL=max(8, ceil(0.001*srate));
  MB_FRICTION_SPEED_SMOOTH=1-exp(-1/(0.0007*srate));
  MB_FRICTION_LEGATO_RAMP=max(8, ceil(0.010*srate));
  MB_FRICTION_LEGATO_VARIATION=0.35;
  MB_FRICTION_LEGATO_TEXTURE_SMOOTH=1-exp(-1/(0.010*srate));
  MB_FRICTION_LEGATO_TEXTURE_RATE=1.0;
  MB_FRICTION_LEGATO_RATE_SLEW=150000; // Hz/second in the audible squeak band.
  MB_FRICTION_LEGATO_SLEW_START=2500; // Lower motion texture keeps its natural onset.
  MB_FRICTION_LEGATO_THRESHOLD=1.;
  MB_FRICTION_LEGATO_SQUEAK_MIX=0.65;
  MB_FRICTION_LEGATO_SQUEAK_FADE=0.006*srate; // Rise time constant, in samples.
  MB_FRICTION_V_SMOOTH=1-exp(-1/(0.0015*srate));
  MB_FRICTION_AMP_SMOOTH=1-exp(-1/(0.001*srate));
  MB_VIBRATO_INTERVAL=max(MB_CONTROL_INTERVAL, ceil(srate/375)); MB_VIBRATO_SMOOTH_MS=20;
  MB_PRESSURE_INTERVAL=max(MB_CONTROL_INTERVAL, ceil(srate/200));
  MB_VIBRATO_INPUTS=MB_MEMORY_WORDS; MB_VI_WORDS=2; MB_VI_DEPTH=0; MB_VI_RATE=1;
  MB_MEMORY_WORDS=MB_VIBRATO_INPUTS+(MB_CHANNELS+1)*MB_VI_WORDS;
  MB_LET_RING_CHANNELS=MB_MEMORY_WORDS; MB_LR_WORDS=2; MB_LR_TOKEN=0; MB_LR_HELD=1;
  MB_MEMORY_WORDS=MB_LET_RING_CHANNELS+MB_CHANNELS*MB_LR_WORDS;
  // Independent performance switches/controllers; append-only, no modal RAM.
  MB_PERF=MB_MEMORY_WORDS; MB_PERF_MAPS=9;
  MB_PF_FINGER=0; MB_PF_STROKE_1=1; MB_PF_STROKE_2=2; MB_PF_PRESSURE=3;
  MB_PF_LH_KEYS=4; MB_PF_LH_VALUE=5; MB_PF_NOISE=6; MB_PF_RH=7;
  MB_PF_SLAP_AUTO=8;
  MB_PF_TAP=9; // Articulation owns its mapping; performance owns style holds.
  MB_PF_PICK=10; // Style-only mapping; no extra map/hold allocation.
  MB_PF_CHORD=11; // Independent routing hold; shares the existing hold pool.
  MB_ROLE_PERF_FIRST=13;
  MB_ROLE_STOP_ALL=25; // One-shot note below LH range; no hold or extra map slot.
  MB_PERF_HOLDS=MB_PERF+MB_PERF_MAPS; MB_PF_HOLD_LIMIT=64; MB_PF_HOLD_WORDS=5;
  MB_PH_SERIAL=0; MB_PH_KIND=1; MB_PH_CHANNEL=2; MB_PH_VALUE=3; MB_PH_STAMP=4;
  MB_PERF_INPUTS=MB_PERF_HOLDS+MB_PF_HOLD_LIMIT*MB_PF_HOLD_WORDS;
  MB_PI_WORDS=4; MB_PI_PRESSURE=0; MB_PI_PRESSURE_STAMP=1; MB_PI_NOISE=2; MB_PI_NOISE_STAMP=3;
  MB_PERF_STRINGS=MB_PERF_INPUTS+MB_CHANNELS*MB_PI_WORDS;
  MB_PS_WORDS=6; MB_PS_PRESSURE=0; MB_PS_PRESSURE_TARGET=1;
  MB_PS_LH=2; MB_PS_GAIN=3; MB_PS_GAIN_TARGET=4; MB_PS_CHANNEL=5;
  MB_PERF_END=MB_PERF_STRINGS+MB_MAX_STRINGS*MB_PS_WORDS;
  MB_MEMORY_WORDS=MB_PERF_END;
  MB_POP_FRET_RATIOS=MB_MEMORY_WORDS;
  MB_POP_FRET_SHAPES=MB_POP_FRET_RATIOS+24;
  MB_MEMORY_WORDS=MB_POP_FRET_SHAPES+24*MB_MAX_MODES;

  // Independent output FIFO: rejected/retired playing notes still pair, and
  // changing forwarding/mapping does not strand a downstream note. Event-only.
  MB_PASS_NOTES=1; MB_PASS_SWITCHES=2; MB_PASS_CONTROLS=4;
  MB_PASS_LIMIT=4096; MB_PASS_WORDS=2; MB_PT_NEXT=0; MB_PT_SENT=1;
  MB_PASSTHROUGH=MB_MEMORY_WORDS; MB_PT_HEADER=4;
  MB_PT_FREE=0; MB_PT_USED=1; MB_PT_ALLOCATED=2; MB_PT_FAULT=3;
  MB_PASS_HEADS=MB_PASSTHROUGH+MB_PT_HEADER;
  MB_PASS_TAILS=MB_PASS_HEADS+MB_KEY_COUNT;
  MB_PASS_RECORDS=MB_PASS_TAILS+MB_KEY_COUNT;
  MB_PASS_END=MB_PASS_RECORDS+MB_PASS_LIMIT*MB_PASS_WORDS;
  MB_MEMORY_WORDS=MB_PASS_END;
  // Four cached style inputs plus four group histories per MIDI channel.
  // Each shared CC uses its first member's history; -1 means no packet received.
  MB_STYLE_CC_BASE=MB_MEMORY_WORDS; MB_STYLE_COUNT=4;
  MB_SC_CHANNELS=MB_STYLE_CC_BASE+MB_STYLE_COUNT;
  MB_SC_WORDS=MB_STYLE_COUNT*(MB_CHANNELS+1);
  MB_MEMORY_WORDS=MB_STYLE_CC_BASE+MB_SC_WORDS;

  // One right hand, two fixed stroke contacts. Pulse words share the finite
  // HO/PO force layout; no extra string/modal bank and no note ownership.
  MB_LANDING=MB_MEMORY_WORDS; MB_LAND_COUNT=2;
  MB_LAND_MODES=32; MB_LAND_LOSS=360;
  // Work reference, not an imposed deflection: the soft pulse and resting
  // contact remove much of this energy. Calibrated separately from pluck gain.
  MB_LAND_DISPLACEMENT=0.01;
  MB_LN_INDEX=MB_HOPO_WORDS; MB_LN_TOKEN=MB_LN_INDEX+1; MB_LN_CHANNEL=MB_LN_INDEX+2;
  MB_LN_HELD=MB_LN_INDEX+3; MB_LN_POSITION=MB_LN_INDEX+4; MB_LN_WIDTH=MB_LN_INDEX+5;
  MB_LN_AMOUNT=MB_LN_INDEX+6; MB_LN_BASE=MB_LN_INDEX+7;
  MB_LAND_WORDS=MB_LN_INDEX+8;
  MB_LANDING_STRINGS=MB_LANDING+MB_LAND_COUNT*MB_LAND_WORDS;
  MB_LD_ONLY=0; MB_LD_REVISION=1; MB_LD_HEADER=2;
  MB_LB_REVISION=0; MB_LB_COUNT=1; MB_LB_LENGTH=2; MB_LB_APPLIED=3;
  MB_LB_LOSS=4; MB_LB_WORDS=MB_LB_LOSS+MB_MAX_MODES;
  MB_LD_WORDS=MB_LD_HEADER+2*MB_LB_WORDS;
  MB_LANDING_END=MB_LANDING_STRINGS+MB_MAX_STRINGS*MB_LD_WORDS;
  MB_MEMORY_WORDS=MB_LANDING_END;
  MB_PF_LAND_1=12; MB_PF_LAND_2=13; // Hold kinds, not extra mapping slots.

  MB_FINGER_INDEX=0; MB_FINGER_MIDDLE=1; MB_FINGER_RESET_MS=2000;
  MB_STYLE_FINGER_AUTO=0; MB_STYLE_FINGER_INDEX=1; MB_STYLE_FINGER_MIDDLE=2;
  MB_STYLE_PICK_AUTO=3; MB_STYLE_PICK_UP=4; MB_STYLE_PICK_DOWN=5;
  MB_STYLE_SLAP_POP_AUTO=6; MB_STYLE_SLAP=7; MB_STYLE_POP=8;
  MB_STYLE_TAP=9;
  MB_EXCITATION_FINGER=1; MB_EXCITATION_POP=2; MB_EXCITATION_SLAP=3; MB_EXCITATION_PICK=4;
  MB_IMPACT_POP=1; MB_IMPACT_SLAP=2; MB_RH_POP=3; MB_RH_SLAP=4;
  MB_RH_PICK_UP=5; MB_RH_PICK_DOWN=6;
  MB_WINDING_PLAIN=0; MB_WINDING_ROUND=1;
  MB_WINDING_FLAT=2; MB_WINDING_TAPE=3;
  MB_STEEL_DENSITY=7850; MB_STEEL_MODULUS=200000000000;
  MB_GAUGE_METERS=0.0000254;
  MB_STRING_CALIBRATION_TENSION=180; MB_STRING_CALIBRATION_LENGTH=0.8636;
  MB_STRING_CALIBRATION_RIGIDITY=0.0001*180*0.8636^2/($pi*$pi);
  // Relative voicing assumptions, not measured brand specifications.
  MB_FLAT_MASS=1.05; MB_FLAT_RIGIDITY=1.25; MB_FLAT_HF_LOSS=2;
  MB_TAPE_MASS=0.78; MB_TAPE_RIGIDITY=0.45; MB_TAPE_HF_LOSS=3;
  MB_PLAIN_HF_LOSS=0.65;
  MB_TAP_KIND=2; MB_TAP_FADE_MS=1; MB_TAP_WORK_SCALE=1;
  MB_TAP_OFFSET=0.035;
  MB_GHOST_GAIN=1;
  MB_GHOST_OFFSET=0.035; MB_GHOST_WIDTH=0.018; MB_GHOST_LOSS=60;
);

// Stable bass identities over the original E/A/D/G/B/C memory slots.
// Six-string convention: B=6, E=5, A=4, D=3, G=2, C=1.
function mb_string_number(index)
global()
( index==4 ? 6 : index==5 ? 1 : 5-index; );
function mb_string_index(number)
global()
( number==6 ? 4 : number==1 ? 5 : 5-number; );

function mb_string_init(st)
(
  memset(st, 0, MB_STRING_WORDS);
  (MB_PERF_STRINGS+floor(st/MB_STRING_WORDS)*MB_PS_WORDS)[MB_PS_PRESSURE]=0;
  st[MB_S_ACTIVE]=st+MB_BANK_A;
  st[MB_S_PREVIOUS]=st+MB_BANK_B;
  st[MB_S_MUTE]=1;
  st[MB_S_NOTE]=st[MB_S_CHANNEL]=-1;
  st[MB_S_TAIL_SAMPLES]=max(1, floor(0.003*srate));
  (st+MB_LIVE)[MB_L_MASK_SMOOTH]=1-exp(-1/(0.001*srate));
  memset(st+MB_MASK_A, 1, MB_MAX_MODES*6);
  memset(st+MB_BEND_DAMP_A, 1, MB_MAX_MODES*2);
  (st+MB_LIVE)[MB_L_DAMP_DB]=MB_BEND_DAMP_DEFAULT;
);
