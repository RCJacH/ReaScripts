// Small audio-thread overlays. No modal coordinates or pickup weights live here.
@init
function mb_performance_string(st)
global(MB_PERF_STRINGS, MB_PS_WORDS, MB_STRING_WORDS)
( MB_PERF_STRINGS+floor(st/MB_STRING_WORDS)*MB_PS_WORDS; );

function mb_landing_ptr(stroke)
global(MB_LANDING, MB_LAND_WORDS)
( MB_LANDING+stroke*MB_LAND_WORDS; );

function mb_landing_string(st)
global(MB_LANDING_STRINGS, MB_LD_WORDS, MB_STRING_WORDS)
( MB_LANDING_STRINGS+floor(st/MB_STRING_WORDS)*MB_LD_WORDS; );

function mb_landing_bank(st, base)
global(MB_LD_HEADER, MB_LB_WORDS, MB_BANK_A)
( mb_landing_string(st)+MB_LD_HEADER+(base!=st+MB_BANK_A)*MB_LB_WORDS; );

function mb_landing_dirty(index)
global(MB_STRING_WORDS, MB_LD_REVISION, landing_mask)
(
  mb_landing_string(index*MB_STRING_WORDS)[MB_LD_REVISION]+=1;
  landing_mask=landing_mask|(2^index);
);

function mb_landing_reset()
global(MB_LANDING, MB_LANDING_END, landing_mask, landing_pulses)
(
  memset(MB_LANDING,0,MB_LANDING_END-MB_LANDING);
  landing_mask=landing_pulses=0;
);

// Lift changes only passive loss. An early release cancels the remaining force;
// no release excitation, oscillator reset or string-owner change is implied.
function mb_landing_release(channel, token)
local(i, p)
global(MB_LAND_COUNT, MB_LN_HELD, MB_LN_CHANNEL, MB_LN_TOKEN, MB_LN_INDEX,
       MB_HP_STATE, MB_HP_LEFT)
(
  i=0; loop(MB_LAND_COUNT,
    p=mb_landing_ptr(i);
    p[MB_LN_HELD] && (channel<0 || p[MB_LN_CHANNEL]==channel) &&
      (token<0 || p[MB_LN_TOKEN]==token) ? (
      p[MB_LN_HELD]=p[MB_HP_STATE]=p[MB_HP_LEFT]=0;
      mb_landing_dirty(p[MB_LN_INDEX]);
    );
    i+=1;
  );
);

// Hard silence already discards the banks; no loss-removal pass is needed.
function mb_landing_forget(st)
local(i, p, index)
global(MB_STRING_WORDS, MB_LAND_COUNT, MB_LN_INDEX, MB_LAND_WORDS, MB_LD_WORDS, landing_mask)
(
  index=floor(st/MB_STRING_WORDS); i=0;
  loop(MB_LAND_COUNT,
    p=mb_landing_ptr(i);
    p[MB_LN_INDEX]==index ? memset(p,0,MB_LAND_WORDS);
    i+=1;
  );
  memset(mb_landing_string(st),0,MB_LD_WORDS);
  landing_mask=landing_mask-(landing_mask&(2^index));
);

function mb_performance_friction_normal(st)
global(MB_PS_LH)
( mb_performance_string(st)[MB_PS_LH]=0; );

function mb_performance_friction_gain(st)
local(p)
global(MB_PS_LH, MB_PS_GAIN, MB_PS_GAIN_TARGET, performance_gain_smooth)
(
  p=mb_performance_string(st);
  p[MB_PS_LH] ? (
    p[MB_PS_GAIN]+=(p[MB_PS_GAIN_TARGET]-p[MB_PS_GAIN])*performance_gain_smooth;
    abs(p[MB_PS_GAIN])<0.000000001 && p[MB_PS_GAIN_TARGET]==0 ? p[MB_PS_GAIN]=0;
    p[MB_PS_GAIN];
  ) : 1;
);

// Relative pressure starts at a normal grip. A released key/open string has no
// extra fretting force. No excitation, velocity loss or note ownership writes.
function mb_pressure_tick(st)
local(p, owner, target, eligible)
global(MB_PS_PRESSURE, MB_PS_PRESSURE_TARGET, MB_O_KEY_DOWN, MB_LIVE, MB_L_FRET,
       MB_STRING_WORDS, MB_OWNERS, MB_OWNER_WORDS, pressure_smooth)
(
  p=mb_performance_string(st); owner=MB_OWNERS+floor(st/MB_STRING_WORDS)*MB_OWNER_WORDS;
  eligible=owner[MB_O_KEY_DOWN] && (st+MB_LIVE)[MB_L_FRET]>0.000000001;
  target=eligible ? p[MB_PS_PRESSURE_TARGET] : 0;
  p[MB_PS_PRESSURE]+=(target-p[MB_PS_PRESSURE])*pressure_smooth;
  abs(p[MB_PS_PRESSURE]-target)<0.000001 ? p[MB_PS_PRESSURE]=target;
  // Crossing to an open span removes the extra force at the geometry boundary.
  (st+MB_LIVE)[MB_L_FRET]<=0.000000001 ? p[MB_PS_PRESSURE]=0;
  p[MB_PS_PRESSURE];
);

function mb_pressure_offset(amount)
global(pressure_tension_current)
( 6*log(1+pressure_tension_current*amount*amount)/log(2); );
