// Audio-owned Ghost and spatial Palm damping.
@init

// ---- ghost ----
// Muted pluck approximation: persistent uniform loss, with optional diagonal
// spatial damping over a finite finger patch. No collision or contact texture.
// Twice the mean squared mode shape over the patch. Coordinate 0 is the
// saddle; the patch is 35 mm into the speaking span from its stopped end.
// Finite width avoids the perfectly undamped nodes of a point approximation.
function mb_ghost_overlap(n, length)
local(offset, width, center)
global(MB_GHOST_OFFSET, MB_GHOST_WIDTH)
(
  offset=min(MB_GHOST_OFFSET, length*0.25);
  width=min(MB_GHOST_WIDTH, offset);
  center=1-offset/length;
  max(0, 1-cos(2*$pi*n*center)*mb_sinc($pi*n*width/length));
);

// Called ONLY on fresh base coefficients (after pluck or geometry rebuild).
// Diagonal loss omits coupling between modes. Retain q/v and omega^2+alpha^2,
// so adding damping neither injects energy nor changes modal stiffness.
// The underdamped oscillator cannot represent real roots: cap added loss at
// alpha=0.95*natural frequency for extreme low tunings, never reduce base loss.
function mb_ghost_coefficients(st, base, count, length)
local(amount, i, ptr, q, v, natural2, alpha, omega, loss, radius)
(
  amount=(st+MB_LIVE)[MB_L_GHOST_AMOUNT];
  amount>0 ? (
    i=0;
    loop(count,
      ptr=base+i*MB_MODE_STRIDE;
      q=ptr[MB_M_R]; v=-ptr[MB_M_ALPHA]*q-ptr[MB_M_OMEGA]*ptr[MB_M_I];
      natural2=ptr[MB_M_OMEGA]^2+ptr[MB_M_ALPHA]^2;
      loss=amount*MB_GHOST_LOSS*mb_ghost_overlap(i+1, length);
      loss=min(loss, max(0, 0.95*sqrt(natural2)-ptr[MB_M_ALPHA]));
      alpha=ptr[MB_M_ALPHA]+loss;
      omega=sqrt(max(0.000000000001, natural2-alpha*alpha));
      ptr[MB_M_I]=-(v+alpha*q)/omega;
      ptr[MB_M_ALPHA]=alpha; ptr[MB_M_OMEGA]=omega;
      radius=exp(-alpha/srate);
      ptr[MB_M_ROT_R]=radius*cos(omega/srate);
      ptr[MB_M_ROT_I]=radius*sin(omega/srate);
      i+=1;
    );
    mb_contact_rebase(st, base);
  );
);

function mb_ghost_excite(st)
local(i, ptr, damp)
(
  // Capture per gesture; later knob edits cannot relax an existing ghost mute.
  damp=exp(-log(1000)/(ghost_decay_ms_current*0.001*srate));
  (st+MB_LIVE)[MB_L_GHOST_DAMP]=damp;
  st[MB_S_MUTE]=min(st[MB_S_MUTE], damp);
  mb_contact_response_scale(st, st[MB_S_ACTIVE], st[MB_S_COUNT], MB_GHOST_GAIN);
  i=0;
  loop(st[MB_S_COUNT],
    ptr=st[MB_S_ACTIVE]+i*MB_MODE_STRIDE;
    ptr[MB_M_R]*=MB_GHOST_GAIN;
    ptr[MB_M_I]*=MB_GHOST_GAIN;
    ptr[MB_M_INITIAL]*=MB_GHOST_GAIN;
    i+=1;
  );
  (st+MB_LIVE)[MB_L_GHOST_AMOUNT]=ghost_damping_current;
  mb_ghost_coefficients(st, st[MB_S_ACTIVE], st[MB_S_COUNT], (st+MB_GEOMETRY)[MB_G_LENGTH]);
  mb_magnet_loss_rebase(st, st[MB_S_ACTIVE]);
  MB_ARTICULATION[MB_A_GHOSTS]+=1;
);

// Enforce before observation: note-off/CC123 may request slower release, but
// cannot relax a ghost's existing mute. A fresh explicit pluck clears this word
// through mb_live_seed; changing/releasing the switch cannot revive vibration.
function mb_ghost_enforce(st)
local(l)
global(MB_LIVE, MB_L_GHOST_DAMP, MB_L_GHOST_AMOUNT, MB_S_COUNT, MB_S_PREVIOUS_LEFT, MB_S_MUTE)
(
  l=st+MB_LIVE;
  l[MB_L_GHOST_DAMP]>0 ? (
    st[MB_S_COUNT]>0 || st[MB_S_PREVIOUS_LEFT]>0 ?
      st[MB_S_MUTE]=min(st[MB_S_MUTE], l[MB_L_GHOST_DAMP]) :
      (l[MB_L_GHOST_DAMP]=0; l[MB_L_GHOST_AMOUNT]=0;);
  );
);

// ---- palm ----
// Finite bridge-relative palm patch. Diagonal viscous loss, not a new voice.
// Preparation runs on gestures/geometry edits and block-rate control changes.
function mb_palm_request()
global(p_palm, p_palm_position, p_palm_width, palm_amount_request, palm_position_request, palm_width_request)
(
  palm_amount_request=mb_clamp(p_palm*0.01, 0, 1);
  palm_position_request=mb_clamp(p_palm_position, 0, 150);
  palm_width_request=mb_clamp(p_palm_width, 1, 80);
);

function mb_palm_bank(st, base)
global(MB_PALM, MB_PM_HEADER, MB_BANK_A, MB_PB_WORDS)
( st+MB_PALM+MB_PM_HEADER+(base!=st+MB_BANK_A)*MB_PB_WORDS; );

// Twice the integral of sin^2 over the patch / requested width. Clipping at
// either endpoint removes coverage; it never relocates the hand into the span.
function mb_palm_overlap(n, length, position, width)
global()
( 2*mb_magnet_overlap(n, position, width, length); );

// Existing q/v and natural stiffness are invariant at the edit boundary.
// The independent modes omit the off-diagonal coupling of a real local damper.
function mb_palm_coefficients(st, base, count, length, fresh)
local(p, b, i, ptr, old, loss, alpha, natural2, changed)
(
  p=st+MB_PALM; b=mb_palm_bank(st, base);
  changed=p[MB_PM_AMOUNT]>0 || (!fresh && b[MB_PB_AMOUNT]>0);
  fresh ? memset(b+MB_PB_LOSS, 0, MB_MAX_MODES);
  changed && count>0 && length>0 ? (
    mb_contact_lazy_flush(st, base);
    i=0; loop(count,
      ptr=base+i*MB_MODE_STRIDE;
      old=(b+MB_PB_LOSS)[i];
      natural2=ptr[MB_M_OMEGA]^2+ptr[MB_M_ALPHA]^2;
      alpha=max(0, ptr[MB_M_ALPHA]-old);
      loss=p[MB_PM_AMOUNT]*MB_PALM_LOSS*
        mb_palm_overlap(i+1, length, p[MB_PM_POSITION], p[MB_PM_WIDTH]);
      loss=min(loss, max(0, 0.95*sqrt(natural2)-alpha));
      loss!=old ? mb_modal_loss_update(ptr,alpha,natural2,loss);
      (b+MB_PB_LOSS)[i]=loss; i+=1;
    );
    mb_contact_rebase(st, base);
    !fresh ? mb_magnet_loss_rebase(st, base);
  );
  b[MB_PB_AMOUNT]=p[MB_PM_AMOUNT]; b[MB_PB_REVISION]=p[MB_PM_REVISION];
  b[MB_PB_COUNT]=count; b[MB_PB_LENGTH]=length;
);

// The same finite-patch diagonal approximation as Palm. Rebuild only at a
// landing/lift or fresh span/coefficients; held fingers add no per-mode work.
function mb_landing_coefficients(st, base, count, length, fresh)
local(d, b, index, i, j, p, loss, old, ptr, alpha, natural2, active)
(
  d=mb_landing_string(st); b=mb_landing_bank(st,base); index=floor(st/MB_STRING_WORDS);
  fresh ? (memset(b+MB_LB_LOSS,0,MB_MAX_MODES); b[MB_LB_APPLIED]=0;);
  fresh || b[MB_LB_REVISION]!=d[MB_LD_REVISION] || b[MB_LB_COUNT]!=count ||
    b[MB_LB_LENGTH]!=length ? (
    active=i=0;
    (landing_mask&(2^index) || b[MB_LB_APPLIED]) && count>0 && length>0 ? (
      mb_contact_lazy_flush(st,base);
      loop(count,
        ptr=base+i*MB_MODE_STRIDE; loss=0; j=0;
        loop(MB_LAND_COUNT,
          p=mb_landing_ptr(j);
          p[MB_LN_HELD] && p[MB_LN_INDEX]==index ?
            loss+=p[MB_LN_AMOUNT]*MB_LAND_LOSS*
              mb_palm_overlap(i+1,length,p[MB_LN_POSITION]*1000,p[MB_LN_WIDTH]*1000);
          j+=1;
        );
        old=(b+MB_LB_LOSS)[i]; natural2=ptr[MB_M_OMEGA]^2+ptr[MB_M_ALPHA]^2;
        alpha=max(0,ptr[MB_M_ALPHA]-old);
        loss=min(loss,max(0,0.95*sqrt(natural2)-alpha));
        loss!=old ? mb_modal_loss_update(ptr,alpha,natural2,loss);
        (b+MB_LB_LOSS)[i]=loss; active=max(active,loss); i+=1;
      );
      mb_contact_rebase(st,base); !fresh ? mb_magnet_loss_rebase(st,base);
    );
    b[MB_LB_APPLIED]=active>0;
    b[MB_LB_REVISION]=d[MB_LD_REVISION]; b[MB_LB_COUNT]=count; b[MB_LB_LENGTH]=length;
  );
);

function mb_landing_apply(st)
local(base, count, length, bank, i, p, active, index, b)
(
  index=floor(st/MB_STRING_WORDS);
  landing_mask&(2^index) ? (
    bank=0; loop(2,
      base=st+(bank==0 ? MB_BANK_A : MB_BANK_B);
      count=base==st[MB_S_ACTIVE] ? st[MB_S_COUNT] :
        st[MB_S_PREVIOUS_LEFT]>0 ? st[MB_S_PREVIOUS_COUNT] : 0;
      length=st[bank==0 ? MB_S_LENGTH_A : MB_S_LENGTH_B];
      count>0 ? mb_landing_coefficients(st,base,count,length,0) : (
        b=mb_landing_bank(st,base);
        b[MB_LB_COUNT]>0 || b[MB_LB_APPLIED] ? memset(b,0,MB_LB_WORDS);
      );
      bank+=1;
    );
    i=active=0; loop(MB_LAND_COUNT,
      p=mb_landing_ptr(i); p[MB_LN_HELD] && p[MB_LN_INDEX]==index ? active=1; i+=1;
    );
    !active ? landing_mask=landing_mask-(landing_mask&(2^index));
  );
);

// A finite pick already owns cached force responses. Defer a live palm edit
// until it releases (<8 ms including Scratch lead); do not restart the gesture.
function mb_palm_apply(st)
local(p, b, bank, base, count, length, fraction, busy, changed)
(
  p=st+MB_PALM;
  busy=st[MB_S_COUNT]>0 || st[MB_S_PREVIOUS_LEFT]>0;
  fraction=busy ? 1-exp(-samplesblock/(0.015*srate)) : 1;
  changed=p[MB_PM_AMOUNT]!=palm_amount_request || p[MB_PM_POSITION]!=palm_position_request ||
    p[MB_PM_WIDTH]!=palm_width_request;
  changed ? (
    p[MB_PM_AMOUNT]+=(palm_amount_request-p[MB_PM_AMOUNT])*fraction;
    p[MB_PM_POSITION]+=(palm_position_request-p[MB_PM_POSITION])*fraction;
    p[MB_PM_WIDTH]+=(palm_width_request-p[MB_PM_WIDTH])*fraction;
    abs(p[MB_PM_AMOUNT]-palm_amount_request)<0.000001 ? p[MB_PM_AMOUNT]=palm_amount_request;
    abs(p[MB_PM_POSITION]-palm_position_request)<0.0001 ? p[MB_PM_POSITION]=palm_position_request;
    abs(p[MB_PM_WIDTH]-palm_width_request)<0.0001 ? p[MB_PM_WIDTH]=palm_width_request;
    p[MB_PM_REVISION]+=1;
  );
  bank=0; loop(2,
    base=st+(bank==0 ? MB_BANK_A : MB_BANK_B);
    count=base==st[MB_S_ACTIVE] ? st[MB_S_COUNT] :
      st[MB_S_PREVIOUS_LEFT]>0 ? st[MB_S_PREVIOUS_COUNT] : 0;
    b=mb_palm_bank(st, base);
    length=st[bank==0 ? MB_S_LENGTH_A : MB_S_LENGTH_B];
    count>0 && b[MB_PB_REVISION]!=p[MB_PM_REVISION] &&
      !(base==st[MB_S_ACTIVE] && (st+MB_PICK)[MB_PK_LEFT]>0) ?
        mb_palm_coefficients(st, base, count, length, 0);
    bank+=1;
  );
);

// ---- finite harmonic touch ----
// Exact passive point-damper half step. q is fixed; v <- v-phi*kick.
// Shapes are fixed in span coordinates; update phi/omega only on coefficient edits.
function mb_harmonic_prepare(st, base, count)
local(b, i, ptr, phi, projection, rebuild, last, edge, table, partial)
(
  b=st+MB_HARMONIC; last=base+(count-1)*MB_MODE_STRIDE;
  partial=st[MB_S_HARMONIC]; table=MB_HARMONIC_SHAPES+(partial-2)*MB_HT_SHAPE_STRIDE;
  rebuild=b[MB_HT_COUNT]!=count || abs(b[MB_HT_OMEGA]-base[MB_M_OMEGA])>0.000000000001 ||
    abs(b[MB_HT_LAST_OMEGA]-last[MB_M_OMEGA])>0.000000000001;
  rebuild ? (b[MB_HT_COUNT]=count; b[MB_HT_NORM]=0;
    b[MB_HT_RATE]=8*st[MB_S_F1];
    b[MB_HT_OMEGA]=base[MB_M_OMEGA]; b[MB_HT_LAST_OMEGA]=last[MB_M_OMEGA];);
  projection=i=0; ptr=base;
  loop(count,
    phi=rebuild ? table[((i+1)*b[MB_HT_NODE])%(2*partial)] : b[MB_HT_PHI+i];
    projection+=phi*(-ptr[MB_M_ALPHA]*ptr[MB_M_R]-ptr[MB_M_OMEGA]*ptr[MB_M_I]);
    rebuild ? (b[MB_HT_PHI+i]=phi; b[MB_HT_WEIGHT+i]=phi/ptr[MB_M_OMEGA]; b[MB_HT_NORM]+=phi*phi;);
    ptr+=MB_MODE_STRIDE; i+=1;
  );
  edge=max(0,min(1,min((b[MB_HT_AGE]+0.5)/max(1,0.0005*srate),
    (b[MB_HT_TOTAL]-b[MB_HT_AGE]-0.5)/max(1,0.2*b[MB_HT_TOTAL]))));
  edge=edge*edge*(3-2*edge);
  b[MB_HT_AMOUNT]=b[MB_HT_NORM]>0 ?
    (1-exp(-edge*b[MB_HT_RATE]*0.5/srate*b[MB_HT_NORM]))/b[MB_HT_NORM] : 0;
  b[MB_HT_KICK]=b[MB_HT_AMOUNT]*projection;
);

function mb_harmonic_apply(st, base, count, kick)
local(b, i, ptr)
global(MB_HARMONIC, MB_HT_PHI, MB_HT_WEIGHT, MB_M_I, MB_MODE_STRIDE)
(
  b=st+MB_HARMONIC; i=0; ptr=base;
  loop(count,
    b[MB_HT_PHI+i]!==0 ? ptr[MB_M_I]+=b[MB_HT_WEIGHT+i]*kick;
    ptr+=MB_MODE_STRIDE; i+=1;
  );
);

// Fuse pre-touch, pickup observation, free rotation and next contact projection.
// No per-mode branch is added to the ordinary renderers; the path ends at lift.
function mb_harmonic_render(st, base, weights, count)
local(b, i, ptr, q, im, v, nr, ni, rr, ri, sum, projection, kick, damper,
      a, c, sum1, sum2, h)
(
  b=st+MB_HARMONIC; kick=b[MB_HT_KICK]; damper=st[MB_S_MUTE];
  circuit_observe_current ? (a=mb_circuit_pickup_ptr(st,weights,0);c=mb_circuit_pickup_ptr(st,weights,1););
  sum=sum1=sum2=projection=i=0; ptr=base;
  loop(count,
    q=ptr[MB_M_R]; im=ptr[MB_M_I];
    b[MB_HT_PHI+i]!==0 ? im+=b[MB_HT_WEIGHT+i]*kick;
    v=-ptr[MB_M_ALPHA]*q-ptr[MB_M_OMEGA]*im; sum+=v*weights[i];
    circuit_observe_current ? (sum1+=v*a[i]; sum2+=v*c[i];);
    rr=ptr[MB_M_ROT_R]; ri=ptr[MB_M_ROT_I];
    nr=(q*rr-im*ri)*damper; ni=(q*ri+im*rr)*damper;
    ptr[MB_M_R]=nr; ptr[MB_M_I]=ni;
    projection+=b[MB_HT_PHI+i]*(-ptr[MB_M_ALPHA]*nr-ptr[MB_M_OMEGA]*ni);
    ptr+=MB_MODE_STRIDE; i+=1;
  );
  b[MB_HT_PROJECTION]=projection;
  circuit_observe_current ? (
    h=st+MB_CIR_PICKUP;
    h[base==st+MB_BANK_A ? MB_CP_A_OUTPUT1 : MB_CP_B_OUTPUT1]=sum1;
    h[base==st+MB_BANK_A ? MB_CP_A_OUTPUT2 : MB_CP_B_OUTPUT2]=sum2;
  );
  sum;
);

function mb_harmonic_finish(st, base, count, cached)
local(b, i, ptr, projection)
(
  b=st+MB_HARMONIC; projection=b[MB_HT_PROJECTION];
  !cached ? (
    projection=i=0; ptr=base;
    loop(count,
      projection+=b[MB_HT_PHI+i]*(-ptr[MB_M_ALPHA]*ptr[MB_M_R]-ptr[MB_M_OMEGA]*ptr[MB_M_I]);
      ptr+=MB_MODE_STRIDE; i+=1;
    );
  );
  mb_harmonic_apply(st,base,count,b[MB_HT_AMOUNT]*projection);
  b[MB_HT_AGE]+=1;
  b[MB_HT_AGE]>=b[MB_HT_TOTAL] ? b[MB_HT_ON]=0;
  mb_contact_invalidate(st);
);
