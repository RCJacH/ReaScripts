// Ordinary excitation and harmonic-touch shaping.
@init

// ---- excitation ----

// Milliseconds. Full velocity retains the configured release; softer gestures
// add up to 0.25 ms at full amount. This shapes excitation, not output filtering.
function mb_excite_softness(softness, velocity)
global(low_velocity_attack_softness_current)
(
  softness+0.25*low_velocity_attack_softness_current*(1-mb_clamp(velocity, 1, 127)/127);
);

function mb_excite_modes(st, velocity)
local(cfg, g, i, n, ptr, freq, omega, alpha, amplitude, h, length, p, width, softness, taper)
(
  cfg=st+MB_CONFIG; g=st+MB_GEOMETRY;
  length=g[MB_G_LENGTH]; p=g[MB_G_P]; width=g[MB_G_WIDTH];
  // Harmonic request is captured before the fresh pluck and passive q/v carry.
  // The existing control adds low-velocity softness to a sharper maximum attack.
  softness=cfg[MB_C_SOFTNESS];
  (st+MB_HARMONIC)[MB_HT_RELEASE] ? softness*=MB_HARMONIC_RELEASE_RATIO;
  softness=mb_excite_softness(softness, velocity);
  h=cfg[MB_C_DISPLACEMENT]*0.001*(mb_clamp(velocity, 1, 127)/127)^velocity_curve_current;
  h*=cfg[MB_C_DIRECTION]==0 ? 1 : -1;
  i=0;
  loop(st[MB_S_COUNT],
    n=i+1; ptr=st[MB_S_ACTIVE]+i*MB_MODE_STRIDE;
    freq=ptr[MB_M_FREQ]; omega=ptr[MB_M_OMEGA]; alpha=ptr[MB_M_ALPHA];
    amplitude=2*h*sin(n*$pi*p)/($pi*$pi*n*n*p*(1-p));
    amplitude*=mb_sinc(n*$pi*width/(2*length));
    amplitude*=exp(-0.5*(omega*softness*0.001)^2-g[MB_G_AGE]*freq/6000);
    taper=freq>0.42*srate ? 0.5+0.5*cos($pi*(freq/srate-0.42)/0.06) : 1;
    amplitude*=taper;
    ptr[MB_M_R]=amplitude;
    ptr[MB_M_I]=-alpha*amplitude/omega;
    ptr[MB_M_INITIAL]=amplitude;
    i+=1;
  );
);

// pluck: 0=force-only seed, 1=Finger, 2=Pop, 3=Slap, 4=Pick contact/release.
// An isolated pluck is unchanged. Repluck folds/carries the moving string and
// crossfades over 3 ms; it never adds a duplicate old-bank pluck tail.
function mb_engine_begin_gesture(st, velocity, note, channel, pluck)
local(cfg, g, weights, repluck, i, ptr, duration)
(
  cfg=st+MB_CONFIG; g=st+MB_GEOMETRY;
  (st+MB_HARMONIC)[MB_HT_ON]=0;
  (st+MB_HARMONIC)[MB_HT_RELEASE]=pluck==1 && (st+MB_HARMONIC)[MB_HT_REQUEST]>0;
  (st+MB_HARMONIC)[MB_HT_REQUEST]=0;
  mb_tension_preserve(st);
  repluck=mb_repluck_capture(st);
  st[MB_S_HARMONIC]=0;
  st[MB_S_PREVIOUS]=st[MB_S_ACTIVE];
  st[MB_S_PREVIOUS_COUNT]=st[MB_S_COUNT];
  st[MB_S_PREVIOUS_LEFT]=st[MB_S_PREVIOUS_COUNT]>0 ? st[MB_S_TAIL_SAMPLES] : 0;
  st[MB_S_ACTIVE]=st[MB_S_ACTIVE]==st+MB_BANK_A ? st+MB_BANK_B : st+MB_BANK_A;
  mb_board_reset(st,st[MB_S_ACTIVE]);
  mb_contact_response_clear(st, st[MB_S_ACTIVE]);
  mb_modal_coefficients(st);
  mb_slap_cancel(st);
  mb_pick_cancel(st);
  pluck==MB_EXCITATION_SLAP ? mb_excite_slap_modes(st, velocity) :
    pluck && pluck!=MB_EXCITATION_PICK ? mb_excite_modes(st, velocity) : (
    // Tap/Pick force arrives later; neither starts with a triangular RH pluck.
    i=0;
    loop(st[MB_S_COUNT],
      ptr=st[MB_S_ACTIVE]+i*MB_MODE_STRIDE;
      ptr[MB_M_R]=ptr[MB_M_I]=ptr[MB_M_INITIAL]=0;
      i+=1;
    );
  );
  (st+MB_HARMONIC)[MB_HT_RELEASE]=0;
  mb_pop_begin(st, pluck==MB_EXCITATION_POP ? MB_IMPACT_POP : pluck==MB_EXCITATION_SLAP ? MB_IMPACT_SLAP : 0);
  mb_palm_coefficients(st, st[MB_S_ACTIVE], st[MB_S_COUNT], g[MB_G_LENGTH], 1);
  landing_mask ? mb_landing_coefficients(st,st[MB_S_ACTIVE],st[MB_S_COUNT],g[MB_G_LENGTH],1);
  mb_landing_string(st)[MB_LD_ONLY]=0;
  mb_gesture_voice_begin(st, pluck==MB_EXCITATION_PICK);
  mb_magnet_rebase(st, st[MB_S_ACTIVE], st[MB_S_COUNT], cfg, g, 1);
  repluck ? mb_repluck_apply(st, pluck==MB_EXCITATION_FINGER ? repluck_grip_current : 0);
  st[MB_S_ACTIVE]==st+MB_BANK_A ? (
    weights=st+MB_PICKUP_A; st[MB_S_LENGTH_A]=g[MB_G_LENGTH];
  ) : (
    weights=st+MB_PICKUP_B; st[MB_S_LENGTH_B]=g[MB_G_LENGTH];
  );
  mb_pickup_capture(st, weights, st[MB_S_COUNT], g[MB_G_LENGTH], cfg);
  st[MB_S_VELOCITY]=velocity;
  st[MB_S_F1]=g[MB_G_F1];
  st[MB_S_NOTE]=note; st[MB_S_CHANNEL]=channel;
  st[MB_S_MUTE]=1;
  mb_electronics_configure(st, cfg);
  mb_live_seed(st);
  mb_fret_response_level(st, !repluck);
  pluck==MB_EXCITATION_SLAP ? mb_slap_arm(st);
  pluck==MB_EXCITATION_PICK ? mb_pick_arm(st, velocity);
  repluck ? (
    (st+MB_LIVE)[MB_L_FADE_KIND]=1;
    (st+MB_LIVE)[MB_L_FADE_TOTAL]=st[MB_S_TAIL_SAMPLES];
    !pluck || pluck==MB_EXCITATION_PICK ? (
      duration=max(1, ceil(MB_TAP_FADE_MS*0.001*srate));
      st[MB_S_PREVIOUS_LEFT]=(st+MB_LIVE)[MB_L_FADE_TOTAL]=duration;
      (st+MB_REPLUCK)[MB_RP_LEFT]>0 ?
        (st+MB_REPLUCK)[MB_RP_LEFT]=(st+MB_REPLUCK)[MB_RP_TOTAL]=duration;
    );
  );
  mb_tension_seed(st, repluck);
);

function mb_engine_excite(st, velocity, note, channel)
global()
( mb_engine_begin_gesture(st, velocity, note, channel, 1); );

// Pop uses the shared lifecycle and passive q/v carry without Finger grip loss.
function mb_engine_pop(st, velocity, note, channel)
global(MB_EXCITATION_POP)
( mb_engine_begin_gesture(st, velocity, note, channel, MB_EXCITATION_POP); );

function mb_engine_slap(st, velocity, note, channel)
global(MB_EXCITATION_SLAP)
( mb_engine_begin_gesture(st, velocity, note, channel, MB_EXCITATION_SLAP); );

function mb_engine_pick(st, velocity, note, channel)
global(MB_EXCITATION_PICK)
( mb_engine_begin_gesture(st, velocity, note, channel, MB_EXCITATION_PICK); );

// Configure a quiet/continuing string for a finite finger pulse, without pluck.
function mb_engine_seed_tap(st, velocity, note, channel)
global()
( mb_engine_begin_gesture(st, velocity, note, channel, 0); );

// ---- harmonics ----
// Finite nodal touch, applied to a new gesture's speaking span. Keep the
// original length, coefficients and pickup geometry; never transpose the fret.
// Switch velocity / CC value chooses the NEXT gesture's partial. Zero releases
// the articulation. Centers 16,32,...,112 select partials 2..8; 0..7 is ordinary.
function mb_harmonic_partial(value)
global()
(
  value=floor(mb_clamp(value, 0, 127));
  value<8 ? 0 : min(8, 2+floor((value-8)/16));
);

// Event-only choice: every node inside the hand span has zero movement cost.
// Ties use the lower touch fret. Coordinates are relative to the speaking span.
function mb_harmonic_node(fret, partial)
local(table, start, end, node, best, distance, best_distance, touch)
global(MB_HARMONIC_SHAPES, MB_HT_SHAPE_STRIDE, MB_HT_NODE_FRETS,
       MB_RACK, MB_R_HAND_START, hand_span_current, hand_fretless_current)
(
  table=MB_HARMONIC_SHAPES+(partial-2)*MB_HT_SHAPE_STRIDE;
  start=MB_RACK[MB_R_HAND_START]; end=start+hand_span_current;
  best=1; best_distance=1000000; node=partial-1;
  loop(partial-1,
    table[MB_HT_NODE_FRETS+node]>0 ? (
      touch=fret+table[MB_HT_NODE_FRETS+node];
      !hand_fretless_current ? touch=floor(touch+0.5);
      distance=max(0,max(start-touch,touch-end));
      distance<best_distance ? (best=node; best_distance=distance;);
    );
    node-=1;
  );
  best;
);

// node=0 queries the next gesture; a captured node keeps held notes stable.
function mb_harmonic_touch_fret(fret, partial, node)
global(MB_HARMONIC_SHAPES, MB_HT_SHAPE_STRIDE, MB_HT_NODE_FRETS)
(
  partial>0 ? (
    node<=0 ? node=mb_harmonic_node(fret,partial);
    fret+(MB_HARMONIC_SHAPES+(partial-2)*MB_HT_SHAPE_STRIDE)[MB_HT_NODE_FRETS+node];
  ) : fret;
);

function mb_harmonic_excite(st, partial)
local(b, i, ptr)
(
  partial=mb_clamp(floor(partial), 2, 8);
  b=st+MB_HARMONIC; memset(b, 0, MB_HT_HEADER);
  st[MB_S_HARMONIC]=partial;
  b[MB_HT_NODE]=mb_harmonic_node((st+MB_LIVE)[MB_L_FRET],partial);
  mb_gesture_voice_begin(st,(st+MB_PICK)[MB_PK_VOICE]|MB_TRIM_TAP);
  b[MB_HT_BANK]=st[MB_S_ACTIVE]; b[MB_HT_COUNT]=-1;
  // No realizable selected mode: preserve the existing silent-above-band rule.
  st[MB_S_COUNT]<partial ? (
    i=0; loop(st[MB_S_COUNT],
      ptr=st[MB_S_ACTIVE]+i*MB_MODE_STRIDE;
      ptr[MB_M_R]=ptr[MB_M_I]=ptr[MB_M_INITIAL]=0; i+=1;
    );
  ) : (
    b[MB_HT_ON]=1;
    b[MB_HT_TOTAL]=ceil(MB_HARMONIC_TOUCH_CYCLES*srate/st[MB_S_F1]);
    b[MB_HT_RATE]=8*st[MB_S_F1]; // R=2Z, M=mu*L/2: R/M=8*f0.
  );
  (st+MB_PICK)[MB_PK_LEFT]>0 ? mb_pick_project(st, partial);
  mb_contact_response_project(st, st[MB_S_ACTIVE], st[MB_S_COUNT], partial);
  mb_contact_invalidate(st);
);

function mb_harmonic_init()
local(partial, i, table, a, b, remainder)
global(MB_HARMONIC_SHAPES, MB_HT_SHAPE_WORDS, MB_HT_SHAPE_STRIDE, MB_HT_NODE_FRETS)
(
  memset(MB_HARMONIC_SHAPES,0,MB_HT_SHAPE_WORDS); partial=2;
  loop(7,
    table=MB_HARMONIC_SHAPES+(partial-2)*MB_HT_SHAPE_STRIDE; i=0;
    loop(2*partial,
      table[i]=i%partial ? sin(i*$pi/partial) : 0; i+=1;
    );
    i=1; loop(partial-1,
      // A reduced fraction isolates the requested partial. Shared nodes would
      // also preserve a lower family (e.g. touching halfway selects partial 2).
      a=partial; b=i;
      while(b>0)(remainder=a%b; a=b; b=remainder;);
      a==1 ? table[MB_HT_NODE_FRETS+i]=12*log(partial/i)/log(2);
      i+=1;
    );
    partial+=1;
  );
);

// GUI telemetry only: the first surviving physical mode includes stiffness,
// detuning and live bend. The engine's F1 remains the base-span fundamental.
function mb_harmonic_frequency(st)
local(partial)
global(MB_S_HARMONIC, MB_S_F1, MB_S_COUNT, MB_S_ACTIVE, MB_MODE_STRIDE, MB_M_FREQ)
(
  partial=st[MB_S_HARMONIC];
  partial ? (st[MB_S_COUNT]>=partial ?
    (st[MB_S_ACTIVE]+(partial-1)*MB_MODE_STRIDE)[MB_M_FREQ] : 0) : st[MB_S_F1];
);
