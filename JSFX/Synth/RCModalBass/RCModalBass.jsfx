@init
mb_instrument_init();
mb_gui_init();

@slider
mb_parameters_request();
mb_native_sliders_update();

@block
mb_block_begin();
while(midirecv(m_off,m_status,m_note,m_vel)) (
  mb_midi_receive(m_off,m_status,m_note,m_vel);
);
mb_block_end();
mb_instrument_publish_strings();

@sample
spl0=spl1=mb_instrument_sample();

@gfx 960 240
mb_gui_draw();
